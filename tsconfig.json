{
  "include": ["src", "index.d.ts"],
  "compilerOptions": {
    "skipLibCheck": true,
    "noImplicitAny": true,
    "allowJs": true,
    "module": "es6",
    "target": "esnext",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["react"],
    "paths": {
      "shell/*": ["./src/shell/*"]
    }
  }
}
